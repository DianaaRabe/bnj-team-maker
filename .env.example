# Copier ce fichier vers .env.local et renseigner les valeurs.
# .env.local est gitignoré : il ne doit jamais être versionné ni zippé
# vers un tiers.

# ─── Cal.com ──────────────────────────────────────────────────────────
# Clé SERVEUR. Pas de préfixe NEXT_PUBLIC_ : elle ne doit jamais atteindre
# le navigateur. Sans elle, le panneau de réservation affiche son état
# d'erreur et propose le lien Cal.com direct.
CAL_API_KEY=

# Identifiant public Cal.com (celui-ci peut être exposé côté client).
NEXT_PUBLIC_CAL_USERNAME=

# ─── Cloudflare — infra uniquement (DNS, R2) ──────────────────────────
# Non requis pour faire tourner la landing.
# Le token doit porter la permission « Zone > DNS > Edit » pour gérer les
# enregistrements DNS.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 / S3 — non utilisé par la landing aujourd'hui.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
